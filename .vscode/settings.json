{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "editor.quickSuggestions": {
    "strings": true
  },
  "eslint.validate": ["javascript"],
  "files.associations": {
  "*.css": "tailwindcss"
  },
  
  "jest.jestCommandLine": "yarn test",
  
 }
 